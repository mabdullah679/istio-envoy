flowchart TD
    start([python scripts/verify.py])
    url[Base URL = --base-url or the istio-ingressgateway NLB hostname]
    warm[Wait until GET /api/public/hello returns 200\nNLB DNS and targets can lag]
    relay{relay: service-a -> service-b\n200 and downstream.service = service-b?}
    valid{validation: bad / long / missing x-user-id\nall HTTP 400?}
    window[Wait for early in the minute\nfixed 1-minute rate-limit windows]
    ns{north-south: 55 requests, one user\nfirst 50 = 200, last 5 = 429?}
    ew{east-west: tester pod -> service-b\n50 x 200 then 5 x 429?}
    mtls{mtls: sidecar caller gets 200,\nno-sidecar pod is reset - curl exit 56?}
    ok([Verification passed - exit 0])
    fail([FAIL - exit non-zero])

    start --> url --> warm --> relay
    relay -->|yes| valid
    valid -->|yes| window --> ns
    ns -->|yes| ew
    ew -->|yes| mtls
    mtls -->|yes| ok
    relay -->|no| fail
    valid -->|no| fail
    ns -->|no| fail
    ew -->|no| fail
    mtls -->|no| fail
