flowchart LR
    user[External client]
    elb["Classic ELB :80"]

    subgraph istioSystem["istio-system"]
        ingress["Ingress gateway x2 (Envoy)"]
        istiod["istiod"]
        ratelimit["Ratelimit service x2"]
        redis[("Redis counters")]
    end

    subgraph demoApps["demo-apps (mTLS STRICT)"]
        tester["tester pod + sidecar"]
        svcA["service-a x2 + sidecar"]
        svcB["service-b x2 + sidecar"]
    end

    ecr[("ECR images")]

    user -->|"HTTP + x-user-id"| elb --> ingress
    ingress -->|"user_id descriptor"| ratelimit --> redis
    ingress -->|"under limit, mTLS"| svcA
    ingress -.->|"over limit: 429"| user
    svcA -->|"mTLS + x-user-id"| svcB
    svcB -->|"user_id descriptor"| ratelimit
    tester -->|"mTLS"| svcB
    istiod -.->|"xDS config and certs"| ingress
    ecr -.->|"image pull"| svcA
    ecr -.->|"image pull"| svcB
